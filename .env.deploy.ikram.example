# Ikram Aid kurulum. SSH alias: ikramaid (~/.ssh/config, Anahtar Zinciri).
# ikramaid.uk izni Ikram Aid yayına alınmadan önce KALDIRILACAK.
# Değer yazmayın; kopyalayıp .env.deploy.ikram olarak doldurun.

DEPLOY_SSH_ALIAS=ikramaid
DEPLOY_WP_PATH=
DEPLOY_SITE_URL=
# Boş yol/URL izin listesinden doldurulur; doluysa birebir aynı olmalı.

# Alias kullanılıyorsa aşağıdaki alanlar boş bırakılabilir.
DEPLOY_SSH_HOST=
DEPLOY_SSH_USER=
DEPLOY_SSH_PORT=
DEPLOY_SSH_KEY=
