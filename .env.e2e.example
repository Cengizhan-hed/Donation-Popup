# Sırlar (uzak hedef kullanılmıyor — profil tek kaynak).
# E2E_BASE_URL uzak profilde yok sayılır (tests/e2e/profiles/*.json + izin listesi).
# wpCliAuth profillerinde E2E_USER / E2E_PASS gerekmez.

E2E_USER=
E2E_PASS=
E2E_LOGIN_PATH=
E2E_PRODUCT_FIXED=
E2E_PRODUCT_CUSTOM=
E2E_PRODUCT_SHARES=
E2E_PRODUCT_CAMPAIGN=
E2E_LIST_PAGE=
E2E_SHOP_PAGE=

# İsteğe bağlı: ekran görüntüsünde maskelenecek ek CSS seçiciler (virgülle ayrılmış).
# Varsayılan liste tests/e2e/helpers/selectors.mjs içindeki DEFAULT_MASK_SELECTORS.
# Örnek: E2E_MASK_SELECTORS=.my-whatsapp-btn,#site-chat-widget
E2E_MASK_SELECTORS=

# Görsel fark eşiği (yüzde). Varsayılan 0.5 — üstü raporda "Değişti" (sayfa ekranları).
E2E_DIFF_THRESHOLD=0.5

# Kabuk (desktop-*-popup-* / desktop-*-panel-*) ekran eşiği. Varsayılan 0.1 —
# küçük modal alanında %0.25’lik buton farkı kaçmasın diye sayfa eşiğinden düşük.
E2E_SHELL_DIFF_THRESHOLD=0.1
