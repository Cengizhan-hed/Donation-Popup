{
  "name": "woo-donation-popup/donation-panel",
  "description": "WooCommerce Donation Popup — WordPress plugin",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "php-stubs/woocommerce-stubs": "^10.0 || ^11.0",
    "php-stubs/wordpress-stubs": ">=6.7",
    "php-stubs/wp-cli-stubs": "^2.11",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6",
    "rector/rector": "^2.7",
    "shipmonk/dead-code-detector": "^1.4",
    "squizlabs/php_codesniffer": "^3.13",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.2"
  },
  "autoload-dev": {
    "psr-4": {
      "WDP\\Tests\\": "tests/unit/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true,
    "vendor-dir": "vendor-dev"
  }
}
