# Staging kurulum (YALNIZCA staging30). Bu dosyayı .env.deploy olarak kopyalayın.
# Canlı site yolu veya URL ASLA yazılmamalı.
# Alias / yol / URL boşsa izin listesinden doldurulur; doluysa birebir aynı olmalı.

DEPLOY_SSH_ALIAS=hedef-staging
DEPLOY_WP_PATH=
DEPLOY_SITE_URL=

# Alias kullanılıyorsa aşağıdaki alanlar boş bırakılabilir.
DEPLOY_SSH_HOST=
DEPLOY_SSH_USER=
DEPLOY_SSH_PORT=
DEPLOY_SSH_KEY=
