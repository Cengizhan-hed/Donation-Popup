{
  "_aciklama": "Yol deseni -> e2e koşucuları (npm betik adları) + elle PHPUnit/JS ek hedefleri. Desen: ** = her derinlik, * = tek klasör düzeyi. Bir dosya birden çok kurala uyabilir (birleşir). 'ignore: true' = test gerektirmez. Hiçbir kurala uymayan dosya GÜVENLİ varsayılana düşer (tüm PHPUnit + JS + e2e:quick). Bu betik ajan içi hızlandırıcıdır, merge kapısı DEĞİLDİR.",
  "rules": [
    { "pattern": "assets/src/experiences/**", "e2e": ["e2e:experiences"], "reason": "Deneyim katmanı JS/CSS" },
    { "pattern": "src/Modules/Experiences/**", "e2e": ["e2e:experiences"], "reason": "Deneyim modülü PHP" },
    { "pattern": "src/Modules/SideCart/**", "e2e": ["e2e:side-cart"], "reason": "Yan sepet modülü" },
    { "pattern": "assets/src/side-cart/**", "e2e": ["e2e:side-cart"], "reason": "Yan sepet JS/CSS" },
    { "pattern": "src/Admin/**", "e2e": ["e2e:admin-e7"], "phpunit": ["tests/unit/Admin"], "reason": "Yönetici ekranları" },
    { "pattern": "assets/css/admin/**", "e2e": ["e2e:admin-e7"], "reason": "Yönetici CSS" },
    { "pattern": "assets/js/admin/**", "e2e": ["e2e:admin-e7"], "reason": "Yönetici JS" },
    { "pattern": "src/Modules/Thanks/**", "e2e": ["e2e:e6"], "reason": "Teşekkür modülü" },
    { "pattern": "src/Modules/TaxRelief/**", "e2e": ["e2e:e6"], "reason": "Vergi indirimi modülü" },
    { "pattern": "assets/src/thanks/**", "e2e": ["e2e:e6"], "reason": "Teşekkür JS/CSS" },
    { "pattern": "src/Modules/DonorAccount/**", "e2e": ["e2e:donor-account"], "reason": "Bağışçı hesabı" },
    { "pattern": "assets/src/donor-account/**", "e2e": ["e2e:donor-account"], "reason": "Bağışçı hesabı JS/CSS" },
    { "pattern": "src/Modules/Campaign/**", "e2e": ["e2e:campaign"], "reason": "Kampanya modülü" },
    { "pattern": "src/Modules/Impact/**", "e2e": ["e2e:campaign"], "reason": "Etki modülü kampanya bloklarında" },
    { "pattern": "src/Modules/SocialProof/**", "e2e": ["e2e:campaign"], "reason": "Sosyal kanıt kampanya bloklarında" },
    { "pattern": "assets/src/campaign/**", "e2e": ["e2e:campaign"], "reason": "Kampanya JS/CSS" },
    { "pattern": "src/Modules/EntryPoints/**", "e2e": ["e2e:entry-points"], "reason": "Giriş yolları" },
    { "pattern": "src/Modules/Preview/**", "e2e": ["e2e:admin-e7"], "reason": "Önizleme (yönetici)" },
    { "pattern": "blocks/**", "e2e": ["e2e:entry-points"], "reason": "Bloklar" },
    { "pattern": "includes/class-shortcode*.php", "e2e": ["e2e:entry-points"], "reason": "Kısa kodlar" },
    { "pattern": "assets/css/**", "e2e": ["e2e:quick", "e2e:quality"], "reason": "Ön yüz CSS: görsel kalite + axe" },
    { "pattern": "templates/**", "e2e": ["e2e:quick", "e2e:quality"], "reason": "Şablonlar: görsel kalite + axe" },
    { "pattern": "assets/js/**", "e2e": ["e2e:quick"], "reason": "Eski ön yüz JS" },
    { "pattern": "src/Privacy/**", "e2e": ["e2e:experiences"], "phpunit": ["tests/unit/Privacy"], "reason": "Gizlilik araçları" },
    { "pattern": "src/Http/**", "e2e": ["e2e:experiences"], "phpunit": ["tests/unit/Core"], "reason": "REST/HTTP" },
    { "pattern": "src/Core/**", "e2e": ["e2e:experiences"], "phpunit": ["tests/unit/Core"], "reason": "Çekirdek" },
    { "pattern": "src/WooCommerce/**", "e2e": ["e2e:experiences", "e2e:side-cart"], "reason": "Woo entegrasyonu (sepet/ödeme)" },
    { "pattern": "tests/e2e/specs/admin-e7.*", "e2e": ["e2e:admin-e7"], "reason": "Spec" },
    { "pattern": "tests/e2e/specs/campaign.*", "e2e": ["e2e:campaign"], "reason": "Spec" },
    { "pattern": "tests/e2e/specs/donor-account.*", "e2e": ["e2e:donor-account"], "reason": "Spec" },
    { "pattern": "tests/e2e/specs/experiences-*", "e2e": ["e2e:experiences"], "reason": "Spec" },
    { "pattern": "tests/e2e/specs/side-cart.*", "e2e": ["e2e:side-cart"], "reason": "Spec" },
    { "pattern": "tests/e2e/specs/thanks-tax.*", "e2e": ["e2e:e6"], "reason": "Spec" },
    { "pattern": "tests/e2e/specs/quality-gates.*", "e2e": ["e2e:quality"], "reason": "Spec" },
    { "pattern": "tests/e2e/run-admin-e7.mjs", "e2e": ["e2e:admin-e7"], "reason": "Koşucu" },
    { "pattern": "tests/e2e/run-campaign.mjs", "e2e": ["e2e:campaign"], "reason": "Koşucu" },
    { "pattern": "tests/e2e/run-donor-account.mjs", "e2e": ["e2e:donor-account"], "reason": "Koşucu" },
    { "pattern": "tests/e2e/run-e6.mjs", "e2e": ["e2e:e6"], "reason": "Koşucu" },
    { "pattern": "tests/e2e/run-entry-points.mjs", "e2e": ["e2e:entry-points"], "reason": "Koşucu" },
    { "pattern": "tests/e2e/run-experiences.mjs", "e2e": ["e2e:experiences"], "reason": "Koşucu" },
    { "pattern": "tests/e2e/run-side-cart.mjs", "e2e": ["e2e:side-cart"], "reason": "Koşucu" },
    { "pattern": "tests/e2e/run-quality.mjs", "e2e": ["e2e:quality"], "reason": "Koşucu" },
    { "pattern": "tests/unit/**", "selfOnly": true, "reason": "Birim testin kendisi" },
    { "pattern": "docs/**", "ignore": true, "reason": "Belge" },
    { "pattern": "*.md", "ignore": true, "reason": "Belge" },
    { "pattern": "build/handoff/**", "ignore": true, "reason": "Teslim notu" },
    { "pattern": "languages/**", "ignore": true, "reason": "Çeviri dosyası" },
    { "pattern": "design/**", "ignore": true, "reason": "Tasarım vitrini" },
    { "pattern": "scripts/**", "jsOnly": true, "reason": "Betik: yalnız bağımlı JS birim testleri" }
  ],
  "safeDefault": { "phpunit": "all", "js": "all", "e2e": ["e2e:quick"] }
}
