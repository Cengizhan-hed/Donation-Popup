{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wdp/donation-form",
  "title": "Donation form",
  "category": "woocommerce",
  "description": "Renders the donation form for the current or selected product.",
  "textdomain": "woo-donation-popup",
  "usesContext": ["postId", "postType"],
  "editorScript": "wdp-block-donation-form",
  "attributes": {
    "productId": { "type": "number", "default": 0 },
    "slug": { "type": "string", "default": "" },
    "sku": { "type": "string", "default": "" },
    "display": { "type": "string", "default": "inline" },
    "layout": { "type": "string", "default": "full", "enum": ["full", "compact"] },
    "showTitle": { "type": "boolean", "default": true },
    "buttonText": { "type": "string", "default": "" }
  }
}
