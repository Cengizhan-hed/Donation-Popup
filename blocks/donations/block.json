{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wdp/donations",
  "title": "Donations list",
  "category": "woocommerce",
  "description": "Lists donation products in a grid.",
  "textdomain": "woo-donation-popup",
  "editorScript": "wdp-block-donations",
  "attributes": {
    "categories": { "type": "string", "default": "" },
    "exclude_categories": { "type": "string", "default": "" },
    "ids": { "type": "string", "default": "" },
    "exclude": { "type": "string", "default": "" },
    "type": { "type": "string", "default": "" },
    "limit": { "type": "number", "default": 48 },
    "orderby": { "type": "string", "default": "menu_order" },
    "order": { "type": "string", "default": "ASC" },
    "tabs": { "type": "string", "default": "yes" },
    "tab_all": { "type": "string", "default": "yes" },
    "tab_all_label": { "type": "string", "default": "" },
    "columns": { "type": "number", "default": 3 },
    "columns_tablet": { "type": "number", "default": 2 },
    "columns_mobile": { "type": "number", "default": 1 },
    "gap": { "type": "number", "default": 24 },
    "image_ratio": { "type": "string", "default": "4:3" },
    "align": { "type": "string", "default": "center" },
    "button": { "type": "string", "default": "panel" },
    "button_full": { "type": "string", "default": "yes" },
    "button_text": { "type": "string", "default": "" },
    "show_image": { "type": "string", "default": "yes" },
    "show_excerpt": { "type": "string", "default": "no" },
    "show_progress": { "type": "string", "default": "yes" },
    "show_price": { "type": "string", "default": "yes" },
    "show_category": { "type": "string", "default": "no" },
    "excerpt_words": { "type": "number", "default": 18 },
    "image_size": { "type": "string", "default": "woocommerce_thumbnail" },
    "heading_tag": { "type": "string", "default": "h3" },
    "class": { "type": "string", "default": "" }
  }
}
