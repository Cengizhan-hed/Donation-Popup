{
  "id": "ikram-aid",
  "name": "Ikram Aid",
  "aliases": ["ikram"],
  "baseUrl": "https://ikramaid.uk",
  "allowedHosts": ["ikramaid.uk", "www.ikramaid.uk"],
  "envFile": ".env.e2e.ikram",
  "deployEnvFile": ".env.deploy.ikram",
  "locale": "en_GB",
  "language": "en",
  "currency": {
    "code": "GBP",
    "symbol": "£",
    "decimals": 2,
    "thousandSeparator": ",",
    "decimalSeparator": ".",
    "symbolPosition": "left"
  },
  "phone": {
    "prefix": "+44",
    "country": "GB",
    "nationalExample": "7700900123"
  },
  "theme": "Blocksy",
  "pageBuilder": "Elementor",
  "listPage": "",
  "shopPage": "",
  "cachePurge": "sg-purge",
  "wpCliAuth": true,
  "comingSoon": true,
  "searchEngineBlock": true,
  "allowMetaMutation": false,
  "checkoutType": "auto",
  "ssh": {
    "alias": "ikramaid",
    "wpPath": "~/www/ikramaid.uk/public_html",
    "siteUrl": "https://ikramaid.uk"
  },
  "strings": {
    "donateButton": "Bağış Yap",
    "donateButtonPattern": "bağış\\s*yap|donate",
    "similarDonations": "Related",
    "similarDonationsPattern": "benzer\\s*bağış|related|similar"
  },
  "selectors": {
    "loopCards": "li.product, .wdp-donations-item, .wdp-card, .elementor-widget-woocommerce-products li.product",
    "loopTitle": ".woocommerce-loop-product__title, .product-title, h2, h3, .wdp-card-title",
    "animated": "",
    "header": "header, .ct-header, #header"
  },
  "products": {
    "custom": {
      "role": "custom"
    },
    "fixed": {
      "role": "fixed"
    },
    "shares": {
      "role": "shares"
    },
    "campaign": {
      "role": "campaign"
    }
  },
  "protectedProductIds": [],
  "altDonationProductId": 0,
  "timeouts": {
    "navigation": 60000
  }
}
