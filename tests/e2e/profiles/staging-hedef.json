{
  "id": "staging-hedef",
  "name": "Hedef Derneği staging",
  "aliases": ["hedef", "staging"],
  "baseUrl": "https://staging30.hedefdernegi.org",
  "allowedHosts": ["staging30.hedefdernegi.org"],
  "envFile": ".env.e2e",
  "deployEnvFile": ".env.deploy",
  "locale": "tr_TR",
  "language": "tr",
  "currency": {
    "code": "TRY",
    "symbol": "₺",
    "decimals": 2,
    "thousandSeparator": ".",
    "decimalSeparator": ",",
    "symbolPosition": "left"
  },
  "phone": {
    "prefix": "+90",
    "country": "TR",
    "nationalExample": "5551234567"
  },
  "theme": "Avada",
  "pageBuilder": "Avada Builder",
  "listPage": "",
  "shopPage": "",
  "cachePurge": "sg-purge",
  "comingSoon": false,
  "searchEngineBlock": false,
  "wpCliAuth": true,
  "allowMetaMutation": false,
  "checkoutType": "classic",
  "ssh": {
    "alias": "hedef-staging",
    "wpPath": "~/www/staging30.hedefdernegi.org/public_html"
  },
  "strings": {
    "donateButton": "Bağış Yap",
    "donateButtonPattern": "bağış\\s*yap",
    "similarDonations": "Benzer Bağışlar",
    "similarDonationsPattern": "benzer\\s*bağış"
  },
  "selectors": {
    "loopCards": "li.post-card, li.fusion-grid-column, .post-card, li.product",
    "loopTitle": ".fusion-title, .woocommerce-loop-product__title, .product-title, h2, h3",
    "animated": ".fusion-post-cards.fusion-animated, .fusion-animated.fusion-grid-archive, .fusion-blog-shortcode.fusion-animated",
    "header": "header, .fusion-header-wrapper, .fusion-header",
    "headings": "h1,h2,h3,h4,.fusion-title,.fusion-title-heading",
    "sectionRoots": ".fusion-fullwidth, .fusion-builder-row, .fusion-post-cards",
    "stabilizeCss": ".fusion-image-wrapper img, .fusion-image-wrapper, .fusion-lazy-load, .awb-image-wrapper{opacity:1!important;visibility:visible!important}\n.fusion-animated, .fusion-post-cards.fusion-animated, .fusion-animated.fusion-grid-archive, .fusion-blog-shortcode.fusion-animated, .awb-animate, [class*=\"fusion-animated\"]{visibility:visible!important;opacity:1!important;animation:none!important;transform:none!important}"
  },
  "products": {
    "custom": {
      "role": "custom"
    },
    "fixed": {
      "role": "fixed"
    },
    "shares": {
      "role": "shares"
    },
    "campaign": {
      "role": "campaign"
    }
  },
  "protectedProductIds": [],
  "altDonationProductId": 0,
  "remoteReadOnlyPostActions": [
    "wmc_get_products_price",
    "hdf_side_cart_v8_get",
    "fusion_get_webfonts_ajax"
  ],
  "currencySwitch": {
    "param": "wmc-currency",
    "codes": ["EUR", "USD"]
  },
  "timeouts": {
    "navigation": 60000
  }
}
