<?xml version="1.0"?>
<ruleset name="Donation Panel">
	<description>Tek PHPCS kural dosyasi: WordPress-Extra + PHPCompatibilityWP. HICBIR gevsetme (exclude/severity) yok. Yalniz gelistirme; pakete girmez.</description>

	<file>src</file>
	<file>templates</file>
	<file>blocks</file>
	<file>woo-donation-popup.php</file>
	<file>uninstall.php</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/vendor-dev/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg value="s"/>

	<config name="minimum_supported_wp_version" value="6.3"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- WooCommerce yetkisi (yeni kural gevsetme degil, bilinen yetki bildirimi). -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="edit_products"/>
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="woo-donation-popup"/>
			</property>
		</properties>
	</rule>

	<!-- Yalniz yeni, >=4 karakterli onekler: kisa (wdp/hdf) onek src/'de YASAK. Kod namespace DonationPanel\ altindadir. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="DonationPanel"/>
				<element value="DONATION_PANEL"/>
				<element value="donation_panel"/>
			</property>
		</properties>
	</rule>
</ruleset>
