<?xml version="1.0"?>
<ruleset name="Woo Donation Popup">
	<description>PHPCS — WordPress-Extra (WordPress-Docs hariç). Yalnız geliştirme; pakete girmez.</description>

	<file>includes</file>
	<file>templates</file>
	<file>blocks</file>
	<file>woo-donation-popup.php</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/vendor-dev/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/tools/bin/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg value="s"/>

	<!-- Eklenti başlığı: Requires at least 5.0, Requires PHP 7.4 -->
	<config name="minimum_supported_wp_version" value="5.0"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="woo-donation-popup"/>
			</property>
		</properties>
	</rule>

	<!-- Proje adlandirmasi: dosyalar class-<ad>.php (sinif adindaki wdp- oneki dosya adinda yok). Yeniden adlandirma yapilmaz. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>*/includes/*</exclude-pattern>
	</rule>

	<!-- wdp/hdf onekleri projenin yerlesik, tutarli onekleridir; mevcut sinif/islev/DB adlari korunur. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.ShortPrefixPassed">
		<severity>0</severity>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="wdp"/>
				<element value="WDP"/>
				<element value="hdf"/>
				<element value="HDF"/>
			</property>
		</properties>
	</rule>
</ruleset>
