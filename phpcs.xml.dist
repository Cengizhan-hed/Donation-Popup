<?xml version="1.0"?>
<ruleset name="Woo Donation Popup">
	<description>PHPCS — WordPress-Extra (WordPress-Docs hariç). Yalnız geliştirme; pakete girmez.</description>

	<file>includes</file>
	<file>templates</file>
	<file>blocks</file>
	<!-- src/ (Faz 7C, yeni mimari) BURADA DEGIL: sifir-gevsetme ayri kural dosyasinda (phpcs-src.xml.dist). -->
	<file>woo-donation-popup.php</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/vendor-dev/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/tools/bin/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>

	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg value="s"/>

	<!-- Eklenti başlığı: Requires at least 5.0, Requires PHP 7.4 -->
	<config name="minimum_supported_wp_version" value="5.0"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="woo-donation-popup"/>
			</property>
		</properties>
	</rule>

	<!-- ESKI KOD ISTISNALARI (yalniz includes/; src/ icin YOK — bkz. docs/MIMARI.md "7A: kural gevsetme plani").
	     Faz 7C'de includes/ src/'ye tasininca bu iki blok ve includes/ girdisi silinir. -->
	<!-- Eski dosyalar class-<ad>.php (sinif adindaki wdp- oneki dosya adinda yok). Yeniden adlandirma yapilmaz. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>*/includes/*</exclude-pattern>
	</rule>

	<!-- wdp/hdf onekleri eski kodun yerlesik onekleridir; mevcut sinif/islev/DB adlari korunur.
	     NOT: bu kural yalniz includes/ ile sinirlanamaz (exclude-pattern eklenince PrefixAllGlobals tum onekleri tanimaz, denendi).
	     src/ kodunda yeni kisa onek acilmaz: code review + docs/MIMARI.md kurali (namespace DonationPanel\, global ad yok). -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.ShortPrefixPassed">
		<severity>0</severity>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="wdp"/>
				<element value="WDP"/>
				<element value="hdf"/>
				<element value="HDF"/>
				<!-- Yeni kod: namespace DonationPanel\ ve donation_panel_ onekli global adlar (>=4 karakter, ShortPrefix hatasi yok). -->
			</property>
		</properties>
	</rule>
</ruleset>
