{
  "name": "donation-popup",
  "version": "10.28.0",
  "description": "WooCommerce donation popup — WordPress plugin.",
  "private": true,
  "scripts": {
    "build:css": "php tools/build-css-bundle.php",
    "build:js": "php tools/build-js-bundle.php",
    "build": "npm run build:css && npm run build:js",
    "smoke": "php tests/smoke/run.php",
    "test": "php vendor/bin/phpunit -c phpunit.xml.dist && node tests/js/compute-donation-total.test.js",
    "test:install": "composer install --no-interaction",
    "verify": "npm run build && npm run smoke",
    "visual:fixtures": "php tools/visual/generate-fixtures.php",
    "visual": "npm run build && npm run visual:fixtures && npx playwright test -c tools/visual/playwright.config.js",
    "pack": "npm run build && sh scripts/package-wp-plugin.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hedefdev/Donation-Popup.git"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "esbuild": "^0.25.5"
  }
}
