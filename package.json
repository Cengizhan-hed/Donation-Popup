{
  "name": "donation-popup",
  "version": "10.35.0",
  "description": "WooCommerce donation popup — WordPress plugin.",
  "private": true,
  "scripts": {
    "build:css": "php tools/build-css-bundle.php",
    "build:js": "php tools/build-js-bundle.php",
    "build": "npm run build:css && npm run build:js",
    "smoke": "php tests/smoke/run.php",
    "test": "php vendor/bin/phpunit -c phpunit.xml.dist && WDP_UNIT_TEST=1 node --test tests/unit/js/*.test.mjs",
    "test:local-wp": "node scripts/test-local-wp.mjs",
    "local-wp:ensure": "node scripts/local-wp.mjs ensure",
    "e2e:bootstrap": "node scripts/e2e-bootstrap.mjs",
    "test:install": "node scripts/install-lint-tools.mjs --composer-only",
    "lint:php": "node scripts/lint-php.mjs",
    "analyse:php": "node scripts/analyse-php.mjs",
    "plugin-check": "node scripts/plugin-check.mjs",
    "verify:live-targets": "node scripts/lib/live-target-scan.mjs",
    "verify:lint": "node scripts/lint-verify-gate.mjs",
    "verify": "npm run build && npm run smoke && npm run verify:live-targets && npm run verify:i18n && npm run verify:lint",
    "pack": "npm run build && sh scripts/package-wp-plugin.sh",
    "e2e": "node tests/e2e/run-compare.mjs",
    "e2e:baseline": "node tests/e2e/run-baseline.mjs",
    "e2e:quick": "node tests/e2e/run-quick.mjs",
    "e2e:full": "node tests/e2e/run-full.mjs",
    "e2e:matrix": "node tests/e2e/run-matrix.mjs",
    "e2e:accept": "node tests/e2e/run-accept.mjs",
    "e2e:stability": "node tests/e2e/run-stability.mjs",
    "e2e:repeat": "node tests/e2e/run-repeat.mjs",
    "e2e:perf": "node tests/e2e/run-perf.mjs",
    "e2e:shares-late": "node tests/e2e/run-shares-late-product-info.mjs",
    "e2e:selftest": "WDP_UNIT_TEST=1 node --test tests/e2e/helpers/auth-classify.test.mjs tests/unit/js/*.test.mjs",
    "deploy:staging": "node scripts/deploy-staging.mjs",
    "deploy:staging:rollback": "node scripts/deploy-staging.mjs --rollback",
    "deploy:ikram": "node scripts/deploy-ikram.mjs",
    "deploy:ikram:rollback": "node scripts/deploy-ikram.mjs --rollback",
    "ikram:wp": "node scripts/ikram-wp.mjs",
    "staging:wp": "node scripts/staging-wp.mjs",
    "e2e:canary": "node tests/e2e/run-canary.mjs",
    "e2e:remote-smoke": "node tests/e2e/run-remote-smoke.mjs",
    "e2e:conflicts": "node tests/e2e/run-conflicts.mjs",
    "ship:staging": "node scripts/ship-staging.mjs",
    "ship:ikram": "node scripts/ship-ikram.mjs",
    "handoff": "node scripts/handoff.mjs",
    "migration:snapshot": "node scripts/migration-snapshot.mjs",
    "migration:rehearsal": "node scripts/migration-rehearsal.mjs",
    "migration:compare": "node scripts/migration-compare.mjs",
    "remote:discover": "node scripts/remote-discover.mjs",
    "admin:style-audit": "node scripts/admin-style-audit.mjs",
    "graph:update": "node scripts/graph-update.mjs",
    "e2e:catalog-explain": "node scripts/e2e-catalog-explain.mjs",
    "i18n:pot": "node tools/i18n/make-pot.mjs",
    "i18n:merge": "node tools/i18n/merge-po.mjs",
    "i18n:mo": "node tools/i18n/compile-mo.mjs",
    "i18n:js-strings": "node tools/i18n/gen-js-strings.mjs",
    "i18n:js-strings:check": "node tools/i18n/gen-js-strings.mjs --check",
    "i18n:extract-source": "node tools/i18n/extract-golden.mjs",
    "i18n:golden": "node tests/e2e/run-i18n-text.mjs",
    "i18n:verify": "node tools/i18n/verify.mjs",
    "i18n:scan-php": "php tools/i18n/scan-php-turkish.php",
    "verify:i18n": "node tools/i18n/merge-po.mjs && node tools/i18n/verify.mjs && php tools/i18n/scan-php-turkish.php && node tools/i18n/verify-js.mjs --scan assets/js/src,assets/js/admin-script.js,assets/js/admin --map tools/i18n/golden/js-J1.json --po languages/woo-donation-popup-tr_TR.po && node tools/i18n/gen-js-strings.mjs --check",
    "i18n:json": "node tools/i18n/make-json.mjs",
    "e2e:rtl": "node tests/e2e/run-rtl-layout.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hedefdev/Donation-Popup.git"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "dotenv": "^16.6.1",
    "esbuild": "^0.25.5",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0"
  }
}
