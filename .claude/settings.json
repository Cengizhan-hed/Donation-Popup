{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cd *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git ls-remote *)",
      "Bash(git ls-files *)",
      "Bash(git check-ignore *)",
      "Bash(git rev-parse *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(git tag *)",
      "Bash(npm run verify)",
      "Bash(npm run test)",
      "Bash(npm run pack)",
      "Bash(npm run e2e:quick)",
      "Bash(npm run e2e:perf)",
      "Bash(npm run e2e:stability)",
      "Bash(npm run e2e:stability *)",
      "Bash(npm run handoff)",
      "Bash(npm run handoff *)",
      "Bash(agent *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(tail *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(sed -n *)",
      "Bash(unzip -l *)",
      "Bash(pgrep *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(mkdir -p build/*)",
      "Read(build/**)",
      "Edit(CLAUDE.md)",
      "Edit(build/handoff/**)",
      "Edit(docs/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(npm run e2e:accept)",
      "Bash(npm run e2e:accept *)",
      "Bash(npm run ship:staging)",
      "Bash(npm run ship:staging *)",
      "Bash(npm run deploy:staging)",
      "Bash(npm run deploy:staging *)",
      "Bash(npm install *)",
      "Bash(npm i *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.e2e)",
      "Read(**/.env.deploy)",
      "Read(**/.env.local)",
      "Edit(**/.env*)",
      "Read(~/.ssh/**)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(cat */.env*)",
      "Bash(head .env*)",
      "Bash(head ./.env*)",
      "Bash(head */.env*)",
      "Bash(tail .env*)",
      "Bash(tail ./.env*)",
      "Bash(tail */.env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Bash(grep * .env*)",
      "Bash(grep * ./.env*)",
      "Bash(grep * */.env*)",
      "Bash(sed * .env*)",
      "Bash(sed * ./.env*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(rm -rf *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(rsync *)",
      "Edit(.claude/**)",
      "Edit(.cursor/**)",
      "Read(tests/e2e/.auth/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  }
}
