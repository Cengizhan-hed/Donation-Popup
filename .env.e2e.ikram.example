# Ikram Aid E2E. Kopyalayıp .env.e2e.ikram yapın; değerleri doldurun.
# Sırlar git'e girmez. Ürün slug'ları boşsa profil adlarından WP-CLI ile çözülür.

E2E_BASE_URL=
E2E_USER=
E2E_PASS=
E2E_LOGIN_PATH=
E2E_PRODUCT_FIXED=
E2E_PRODUCT_CUSTOM=
E2E_PRODUCT_SHARES=
E2E_PRODUCT_CAMPAIGN=
E2E_LIST_PAGE=
E2E_SHOP_PAGE=
E2E_MASK_SELECTORS=
E2E_DIFF_THRESHOLD=0.5
E2E_SHELL_DIFF_THRESHOLD=0.1

# WooCommerce Coming soon gizli paylaşım anahtarı (isteğe bağlı).
# Boşsa WP-CLI mevcut woocommerce_share_key okunur; option yazılmaz / görünürlük değişmez.
E2E_COMING_SOON_SHARE_KEY=
